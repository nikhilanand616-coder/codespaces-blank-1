# Razorpay Configuration
# Get these from your Razorpay Dashboard: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Set your backend URL for production
BACKEND_URL=https://your-domain.com

# Optional external bank rate provider URL
# Use a trusted finance API endpoint that returns rdBanks and fdBanks payloads.
BANK_RATES_SOURCE_URL=https://example.com/api/v1/bank-rates
# Cache duration for external bank rates (seconds)
BANK_RATES_CACHE_TTL_SECONDS=30

# Google Identity Services sign-in. Create a Web client in Google Cloud and add
# http://localhost:3000 as an authorized JavaScript origin for local use.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Gemini AI / Google Generative Language configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
# Optional alternative key names
# GOOGLE_API_KEY=your_google_gemini_api_key_here
# GEMINI_APIKEY=your_google_gemini_api_key_here
# GEMINI_USE_API_KEY=true
# GEMINI_MODEL=gemini-4.0
